{
  "name": "ai-news-wallpaper",
  "version": "1.0.0",
  "description": "Keeps your Windows desktop wallpaper updated with the latest AI news headlines.",
  "bin": {
    "ai-news-wallpaper": "bin/cli.js",
    "ainews": "bin/cli.js"
  },
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "update": "node bin/cli.js update",
